# ==============================================================
# APEX FINTECH - CẤU HÌNH MÔI TRƯỜNG (.env)
#
# ⚠️ Môi trường dùng chung cho 3 target — xem bảng bên dưới.
#
#  Env       | Code trên server | Port | Database          | Domain quản trị
# -----------|------------------|------|-------------------|----------------------------
#  local     | C:\code\...      | 8080 | apex_leads (docker) | localhost
#  test      | C:\apex-test     | 8081 | apex_leads_test    | test.hanghoaphaisinh.net
#  production| C:\apex          | 8080 | apex_leads         | crm.hanghoaphaisinh.net
#
# File mẫu đầy đủ cho từng môi trường:
#   deploy/windows/env.test.example
#   deploy/windows/env.production.example
# ==============================================================

# 0. Định danh môi trường — backend dùng để chọn đúng tập admin host,
#    domain on-demand và chế độ đồng bộ ra ngoài.
#    Giá trị hợp lệ: local | test | production
#    ⚠️ Nếu để trống, backend suy ra từ DB_NAME:
#       apex_leads_test ⇒ test · apex_leads ⇒ production · khác ⇒ local
APEX_ENV=local

# 1. Cổng lắng nghe của Backend Server (mặc định: 8080)
PORT=8080

# 2. Cấu hình CSDL PostgreSQL (Docker hoặc CSDL độc lập)
# Nếu dùng docker-compose: DB_HOST=postgres (hoặc localhost nếu chạy binary ngoài docker)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=apex_leads
DB_SSLMODE=disable

# Chuỗi kết nối đầy đủ (Tùy chọn - nếu khai báo sẽ ghi đè các mục trên)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/apex_leads?sslmode=disable

# 3. CORS & Bảo mật
# Cho phép tất cả domain truy cập API hoặc chỉ định domain: https://crm.hanghoaphaisinh.net
# ⚠️ CORS mặc định `*` — KHÔNG đổi (landing domain khác sẽ không gửi lead được).
ALLOW_ORIGINS=*
ADMIN_KEY=apex080

# 3.1 Secret ký HMAC cho Proof-of-Work Challenge (SINH NGẪU NHIÊN - đổi lại khi bị lộ)
# Để trống sẽ dùng giá trị mặc định trong backend/security/challenge.go
CHALLENGE_SECRET=

# 3.2 Host được phục vụ giao diện CRM Admin (phân tách bởi dấu phẩy)
# ⚠️ CHỈ các host này được phục vụ /ads và /admin. Landing domain công khai
#    (ads.giaodichhanghoatuonglai.com, lophoc.hanghoaphaisinh.net, ...) bị chặn.
# Để trống ⇒ dùng mặc định theo APEX_ENV.
# APEX_ADMIN_HOSTS=localhost,127.0.0.1

# 3.3 Domain được phép cấp SSL on-demand (dùng cho endpoint check-domain)
# ⚠️ Production giữ suffix matching `*.hanghoaphaisinh.net` bên trong code (tương
#    thích ngược với hành vi cũ) ⇒ không cần khai báo wildcard ở đây.
# ⚠️ KHÔNG dùng wildcard `*.hanghoaphaisinh.net` — domain lạ sẽ bị từ chối
#    ⇒ Caddy không cấp nhầm chứng chỉ cho môi trường khác.
# Để trống ⇒ dùng mặc định theo APEX_ENV.
# APEX_ON_DEMAND_DOMAINS=localhost,127.0.0.1

# 3.4 Đồng bộ ra ngoài (Meta CAPI + Google Sheets)
# ⚠️ Môi trường `test` mặc định TẮT (lead thử nghiệm không làm nhiễu KPI
#    doanh thu thật và không ghi vào Google Sheets production).
# Để trống ⇒ tự động theo APEX_ENV.
# APEX_DISABLE_EXTERNAL_SYNC=true

# 4. Tài khoản Admin khởi tạo tự động lần đầu (nếu DB chưa có)
# Username: admin
# Password mặc định: ApexAdmin@2026! (Băm tự động bằng Argon2id)

# 5. Thông tin Tên Miền & DNS
# Domain Admin: crm.hanghoaphaisinh.net/ads
# IP Máy chủ: 103.124.95.232
# NS1: ns1.hanghoaphaisinh.net
# NS2: ns2.hanghoaphaisinh.net

# 6. Google Sheets API Master Service Account (Email Bot)
# Mặc định server tự động dò tìm file 'service-account.json' trong thư mục backend/ hoặc thư mục dự án
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_BOT_EMAIL=sheet-bot@rinva-drive-tool.iam.gserviceaccount.com
# Hoặc truyền trực tiếp chuỗi JSON:
# GOOGLE_SERVICE_ACCOUNT_JSON=

# 7. Meta Conversions API (Facebook Ads) — mặc định dùng cấu hình trong CRM
#
# ⚠️ Cấu hình CHÍNH được quản lý trong tab "Facebook Ads" của CRM và lưu trong
#    bảng `facebook_capi_configs` (theo landing_id). Các biến dưới đây chỉ là
#    FALLBACK khi chưa có cấu hình nào trong DB.
#
# META_CAPI_DEFAULT_PIXEL_ID=
# META_CAPI_DEFAULT_ACCESS_TOKEN=
# META_CAPI_DEFAULT_API_VERSION=v27.0
# META_CAPI_DEFAULT_CURRENCY=VND
# META_CAPI_DEFAULT_COURSE_VALUE=6000000

# 7.1 Meta Conversions API Gateway (tuỳ chọn)
# Bật để gửi sự kiện qua Gateway thay vì gọi trực tiếp Graph API.
# Endpoint dạng: https://apac.gateway.facebook.com  (region: apac | us | eu)
# META_CAPI_GATEWAY_ENABLED=false
# META_CAPI_GATEWAY_ENDPOINT=
# META_CAPI_GATEWAY_ACCESS_KEY=

# 7.2 Danh sách landing CẤM CAPI tầng server (2026-11-18)
#
# ⚠️ Landing trong danh sách này KHÔNG BAO GIỜ bắn sự kiện CAPI từ server —
#    chỉ dùng Meta Pixel nhúng trong HTML.
#
# ⚠️ Bắt buộc vì `GetFacebookCAPIConfig(landingID)` FALLBACK sang dòng cấu hình
#    MẶC ĐỊNH (`landing_id = ''`) khi landing chưa có dòng riêng ⇒ chỉ cần tạo
#    1 cấu hình mặc định là mọi landing (kể cả landing không dùng CAPI) bắt
#    đầu bắn sự kiện lên Meta ⇒ chiến dịch Meta báo lỗi dữ liệu.
#
# Nhiều landing thì ngăn cách bằng dấu phẩy (không cần space).
# Giá trị mặc định trong code: `landing_cu`
# META_CAPI_BLOCKED_LANDINGS=landing_cu
