# ==============================================================
# APEX FINTECH - CẤU HÌNH MÁY CHỦ SẢN XUẤT (.env)
# ==============================================================

# 1. Cổng lắng nghe của Backend Server (mặc định: 8080)
PORT=8080

# 2. Cấu hình CSDL PostgreSQL (Docker hoặc CSDL độc lập)
# Nếu dùng docker-compose: DB_HOST=postgres (hoặc localhost nếu chạy binary ngoài docker)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=apex_leads
DB_SSLMODE=disable

# Chuỗi kết nối đầy đủ (Tùy chọn - nếu khai báo sẽ ghi đè các mục trên)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/apex_leads?sslmode=disable

# 3. CORS & Bảo mật
# Cho phép tất cả domain truy cập API hoặc chỉ định domain: https://crm.hanghoaphaisinh.net
ALLOW_ORIGINS=*
ADMIN_KEY=apex080

# 4. Tài khoản Admin khởi tạo tự động lần đầu (nếu DB chưa có)
# Username: admin
# Password mặc định: ApexAdmin@2026! (Băm tự động bằng Argon2id)

# 5. Thông tin Tên Miền & DNS
# Domain Admin: crm.hanghoaphaisinh.net/ads
# IP Máy chủ: 103.173.226.15
# NS1: ns1.hanghoaphaisinh.net
# NS2: ns2.hanghoaphaisinh.net
