# ==============================================================
# APEX FINTECH — CẤU HÌNH MÔI TRƯỜNG TEST
# Môi trường dùng để up code và kiểm thử trước khi deploy production.
#
# Server : 103.124.95.232 (Windows Server 2025)
# Code   : C:\apex-test  (clone của github.com/itdoanh/apex-crm.git, branch `test`)
# Domain : test.hanghoaphaisinh.net
# DB    : apex_leads_test (PostgreSQL native @ localhost:5432)
# Task  : Apex_Backend_Server_Test  (WD = C:\apex-test\backend)
#
# ⚠️ Môi trường test CÔ LẬP:
#   - KHÔNG gửi Meta CAPI (PageView/Lead/Purchase) lên tài khoản quảng cáo thật
#   - KHÔNG đồng bộ lead sang Google Sheets production
#   - DB riêng `apex_leads_test` ⇒ lead thử nghiệm không lẫn vào KPI production
# ==============================================================

# 0. Định danh môi trường — backend dùng để chọn đúng tập admin host,
#    domain on-demand và chế độ đồng bộ ra ngoài.
#    Giá trị hợp lệ: local | test | production
APEX_ENV=test

# 1. Cổng lắng nghe của Backend Server — KHÁC production (8080)
PORT=8081

# 2. Cấu hình CSDL PostgreSQL — DB RIÊNG cho môi trường test
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=apex_leads_test
DB_SSLMODE=disable

# 3. CORS & Bảo mật
#    ⚠️ CORS mặc định `*` — KHÔNG đổi (landing domain khác cần gửi lead).
ALLOW_ORIGINS=*
ADMIN_KEY=apex080

# 3.1 Secret ký HMAC cho Proof-of-Work Challenge
#     ⚠️ Dùng secret KHÁC production để challenge của test không bị
#     production chấp nhận (và ngược lại).
CHALLENGE_SECRET=apex_fintech_test_secret_2026_do_not_use_in_prod

# 3.2 Host được phục vụ giao diện CRM Admin (phân tách bởi dấu phẩy)
APEX_ADMIN_HOSTS=test.hanghoaphaisinh.net,localhost,127.0.0.1

# 3.3 Domain được phép cấp SSL on-demand (dùng cho endpoint check-domain)
APEX_ON_DEMAND_DOMAINS=test.hanghoaphaisinh.net,ns1.hanghoaphaisinh.net,ns2.hanghoaphaisinh.net

# 3.4 Tắt đồng bộ ra ngoài (Meta CAPI + Google Sheets) — BẮT BUỘC cho test
APEX_DISABLE_EXTERNAL_SYNC=true

# 4. Thông tin Tên Miền & DNS (tham khảo)
#    Domain Test : test.hanghoaphaisinh.net
#    IP Máy chủ : 103.124.95.232
#    NS1: ns1.hanghoaphaisinh.net
#    NS2: ns2.hanghoaphaisinh.net

# 5. Google Sheets API Master Service Account (Email Bot)
#    ⚠️ Môi trường test KHÔNG ghi vào sheet production.
#    File service-account.json vẫn được copy sang để có thể test kết nối
#    (nếu cần), nhưng `APEX_DISABLE_EXTERNAL_SYNC=true` chặn việc ghi lead.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_BOT_EMAIL=sheet-bot@rinva-drive-tool.iam.gserviceaccount.com

# 6. Meta Conversions API (Facebook Ads)
#    ⚠️ Cấu hình CHÍNH nằm trong CRM (bảng `facebook_capi_configs`).
#    Các biến dưới đây chỉ là FALLBACK. Môi trường test ĐÃ TẮT CAPI
#    ở tầng code (`APEX_DISABLE_EXTERNAL_SYNC=true`) ⇒ không cần khai báo.
#
# META_CAPI_DEFAULT_PIXEL_ID=
# META_CAPI_DEFAULT_ACCESS_TOKEN=
# META_CAPI_DEFAULT_API_VERSION=v27.0
# META_CAPI_DEFAULT_CURRENCY=VND
# META_CAPI_DEFAULT_COURSE_VALUE=6000000

# 7. Meta Conversions API Gateway (tuỳ chọn)
# META_CAPI_GATEWAY_ENABLED=false
# META_CAPI_GATEWAY_ENDPOINT=
# META_CAPI_GATEWAY_ACCESS_KEY=
