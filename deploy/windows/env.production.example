# ==============================================================
# APEX FINTECH — CẤU HÌNH MÔI TRƯỜNG PRODUCTION
# Môi trường thực tế — nhận lead thật, đồng bộ Google Sheets, gửi Meta CAPI.
#
# Server : 103.124.95.232 (Windows Server 2025)
# Code   : C:\apex  (clone của github.com/itdoanh/apex-crm.git, branch `main`)
# Domain : crm.hanghoaphaisinh.net (CRM) + các landing domain khác
# DB    : apex_leads (PostgreSQL native @ localhost:5432)
# Task  : Apex_Backend_Server  (WD = C:\apex\backend)
#
# ⚠️ File .env này KHÔNG được commit (đã có trong .gitignore).
#    Chỉ dùng làm mẫu tham chiếu — file thật nằm ở C:\apex\.env trên server.
# ==============================================================

# 0. Định danh môi trường — backend dùng để chọn đúng tập admin host,
#    domain on-demand và chế độ đồng bộ ra ngoài.
#    Giá trị hợp lệ: local | test | production
APEX_ENV=production

# 1. Cổng lắng nghe của Backend Server (mặc định: 8080)
PORT=8080

# 2. Cấu hình CSDL PostgreSQL (native, chỉ listen loopback)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=apex_leads
DB_SSLMODE=disable

# 3. CORS & Bảo mật
#    ⚠️ CORS mặc định `*` — KHÔNG đổi (landing domain khác cần gửi lead).
ALLOW_ORIGINS=*
ADMIN_KEY=apex080

# 3.1 Secret ký HMAC cho Proof-of-Work Challenge (SINH NGẪU NHIÊN)
CHALLENGE_SECRET=

# 3.2 Host được phục vụ giao diện CRM Admin (phân tách bởi dấu phẩy)
#     ⚠️ Chỉ các host này được phục vụ /ads và /admin. Landing domain công khai
#     (ads.giaodichhanghoatuonglai.com, lophoc.hanghoaphaisinh.net, ...) bị chặn.
APEX_ADMIN_HOSTS=crm.hanghoaphaisinh.net,localhost,127.0.0.1,103.124.95.232

# 3.3 Domain được phép cấp SSL on-demand (dùng cho endpoint check-domain)
#     ⚠️ KHÔNG dùng wildcard `*.hanghoaphaisinh.net` trong biến này — production
#     đã giữ suffix matching `*.hanghoaphaisinh.net` bên trong code (tương thích
#     ngược với hành vi cũ) ⇒ không cần khai báo ở đây.
#     ⚠️ `test.hanghoaphaisinh.net` CỐ Ý có mặt: Caddy 2.8.4 chỉ có MỘT global
#     `on_demand_tls` dùng chung cho mọi site block (kể cả block của môi
#     trường test) và hỏi endpoint này. Thiếu nó ⇒ test domain không có HTTPS.
APEX_ON_DEMAND_DOMAINS=crm.hanghoaphaisinh.net,hanghoaphaisinh.net,ns1.hanghoaphaisinh.net,ns2.hanghoaphaisinh.net,test.hanghoaphaisinh.net

# 3.4 Đồng bộ ra ngoài (Meta CAPI + Google Sheets) — production BẬT
APEX_DISABLE_EXTERNAL_SYNC=false

# 4. Thông tin Tên Miền & DNS
#    Domain Admin: crm.hanghoaphaisinh.net/ads
#    IP Máy chủ: 103.124.95.232
#    NS1: ns1.hanghoaphaisinh.net
#    NS2: ns2.hanghoaphaisinh.net

# 5. Google Sheets API Master Service Account (Email Bot)
#    Mặc định server tự động dò tìm file 'service-account.json' trong thư mục
#    backend/ hoặc thư mục dự án.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_BOT_EMAIL=sheet-bot@rinva-drive-tool.iam.gserviceaccount.com
# Hoặc truyền trực tiếp chuỗi JSON:
# GOOGLE_SERVICE_ACCOUNT_JSON=

# 6. Meta Conversions API (Facebook Ads) — mặc định dùng cấu hình trong CRM
#
# ⚠️ Cấu hình CHÍNH được quản lý trong tab "Facebook Ads" của CRM và lưu trong
#    bảng `facebook_capi_configs` (theo landing_id). Các biến dưới đây chỉ là
#    FALLBACK khi chưa có cấu hình nào trong DB.
#
# META_CAPI_DEFAULT_PIXEL_ID=
# META_CAPI_DEFAULT_ACCESS_TOKEN=
# META_CAPI_DEFAULT_API_VERSION=v27.0
# META_CAPI_DEFAULT_CURRENCY=VND
# META_CAPI_DEFAULT_COURSE_VALUE=6000000

# 7. Meta Conversions API Gateway (tuỳ chọn)
# Bật để gửi sự kiện qua Gateway thay vì gọi trực tiếp Graph API.
# META_CAPI_GATEWAY_ENABLED=false
# META_CAPI_GATEWAY_ENDPOINT=
# META_CAPI_GATEWAY_ACCESS_KEY=
